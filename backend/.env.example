# Copiar a .env y completar.

# API key de Google Places (New) — habilitarla en Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Ruta del archivo SQLite. Por default se crea junto al backend.
LEADGEN_DB_PATH=./leadgen.db

# Cuántos leads se re-verifican por corrida del proceso de refresco.
REFRESH_BATCH_SIZE=50

# Intentos fallidos seguidos antes de marcar un lead como inactivo.
MAX_VERIFICATION_ATTEMPTS=3
